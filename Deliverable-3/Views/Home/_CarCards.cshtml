@model IEnumerable<Car>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
@foreach (var car in Model)
{
    var imagePath = car.Name.Contains("Corolla", StringComparison.OrdinalIgnoreCase) ? Url.Content("~/images/corolla.jpg")
        : car.Name.Contains("Civic", StringComparison.OrdinalIgnoreCase) ? Url.Content("~/images/civic.jpg")
        : car.Name.Contains("Prado", StringComparison.OrdinalIgnoreCase) ? Url.Content("~/images/prado.jpg") : null;
    <div class="col-md-6 col-lg-4 car-item">
        <article class="car-card h-100">
            <div class="car-photo">
                @if (imagePath != null)
                {
                    <img src="@imagePath" alt="@car.Name" loading="lazy" />
                }
                else
                {
                    <div class="car-photo-placeholder"><i class="bi bi-car-front-fill"></i><span>DRIVENOW FLEET</span></div>
                }
                <span class="availability"><i></i> Available</span>
                <span class="photo-label">DRIVENOW SELECT</span>
            </div>
            <div class="car-info">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div><h3>@car.Name</h3><p><i class="bi bi-car-front me-1"></i> Comfortable • Reliable • Ready</p></div>
                    <div class="price"><b>Rs. @car.Rate.ToString("N0")</b><small>/ day</small></div>
                </div>
                <div class="car-features"><span><i class="bi bi-snow"></i> A/C</span><span><i class="bi bi-people"></i> 5 seats</span><span><i class="bi bi-fuel-pump"></i> Petrol</span></div>
                @if (isAuthenticated)
                {
                    <a class="btn btn-card w-100" asp-controller="Customer" asp-action="Book" asp-route-id="@car.Id">Book this car <i class="bi bi-arrow-up-right ms-1"></i></a>
                }
                else
                {
                    <a class="btn btn-card w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Book", "Customer", new { id = car.Id })">Login to book <i class="bi bi-arrow-up-right ms-1"></i></a>
                }
            </div>
        </article>
    </div>
}
