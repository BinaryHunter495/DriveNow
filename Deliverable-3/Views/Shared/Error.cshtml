@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="page-hero"><div class="container"><div class="eyebrow">DRIVENOW SUPPORT</div><h1>We hit a <em>roadblock.</em></h1><p>An unexpected error occurred while processing your request.</p></div></section>
<div class="container content-overlap"><div class="surface-card p-4 p-md-5 text-center"><i class="bi bi-cone-striped display-3 text-primary"></i><h2 class="mt-3">Please try again</h2><p class="muted">If the issue continues, contact the site administrator.</p>@if (Model?.ShowRequestId == true) { <p class="small text-secondary">Request ID: <code>@Model.RequestId</code></p> }<a asp-controller="Home" asp-action="Index" class="btn btn-accent">Back to home</a></div></div>
